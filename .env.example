# Flowy · variables de entorno
# Copia este archivo como .env y rellena los valores. El .env no se sube a git.
# Todas son SOLO de servidor, salvo SUPABASE_URL y SUPABASE_ANON_KEY,
# que son públicas y el navegador las recibe por /api/config.

# IA principal: gemini | claude. Si falla, se usa la otra de respaldo (si tiene clave).
AI_PROVIDER=gemini

# Gemini · clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Vacío = gemini-3.6-flash
GEMINI_MODEL=
# Si el principal está saturado, se usa este (vacío = gemini-3.5-flash)
GEMINI_MODEL_RESPALDO=
# Voz de los videos (vacío = gemini-3.8-flash-lite-tts; si está saturado, gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=

# Claude · clave en https://platform.claude.com/
ANTHROPIC_API_KEY=
# Vacío = claude-opus-5-5
CLAUDE_MODEL=

# Supabase · Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secreta: se salta las reglas RLS. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Guiones gratis por IP y hora
GUIONES_POR_HORA=10
# Voces para videos por IP y hora (un video de 30–60 s usa una)
VOCES_POR_HORA=20

# Opcional: puerto del servidor local (3000 por defecto)
# PORT=3000
